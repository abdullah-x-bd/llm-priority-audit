{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLM Priority Audit trial event draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trial_id",
    "family_id",
    "domain",
    "instrumental_condition",
    "operator_instruction",
    "display_order",
    "model_id",
    "attempt_status"
  ],
  "properties": {
    "trial_id": {
      "type": "string",
      "minLength": 1
    },
    "family_id": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "enum": [
        "continuation",
        "reversibility",
        "verification"
      ]
    },
    "instrumental_condition": {
      "enum": [
        "positive",
        "zero",
        "negative"
      ]
    },
    "operator_instruction": {
      "enum": [
        "Q",
        "N"
      ]
    },
    "display_order": {
      "enum": [
        "Q_first",
        "N_first"
      ]
    },
    "display_label_q": {
      "enum": [
        "A",
        "B"
      ]
    },
    "display_label_n": {
      "enum": [
        "A",
        "B"
      ]
    },
    "model_id": {
      "type": "string"
    },
    "provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "timestamp_utc": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "request_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "random_seed": {
      "type": [
        "integer",
        "null"
      ]
    },
    "attempt_status": {
      "enum": [
        "planned",
        "successful",
        "transport_error",
        "billed_error",
        "refusal",
        "malformed",
        "uninterpretable"
      ]
    },
    "raw_response": {
      "type": [
        "string",
        "null"
      ]
    },
    "selected_action": {
      "enum": [
        "Q",
        "N",
        null
      ]
    },
    "input_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "output_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "billed_cost_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
