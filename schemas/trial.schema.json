{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Planned OpenRouter trial event protocol v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trial_id",
    "family_id",
    "domain",
    "frame",
    "condition",
    "directive",
    "layout",
    "model_id",
    "attempt_status"
  ],
  "properties": {
    "trial_id": {
      "type": "string",
      "minLength": 3
    },
    "family_id": {
      "type": "string",
      "pattern": "^(CONT|REVR|VERF)-[0-9]{3}$"
    },
    "domain": {
      "enum": [
        "continuation",
        "reversibility",
        "verification"
      ]
    },
    "mechanism": {
      "type": [
        "string",
        "null"
      ]
    },
    "frame": {
      "enum": [
        "priority",
        "neutral"
      ]
    },
    "condition": {
      "enum": [
        "positive",
        "zero",
        "negative"
      ]
    },
    "directive": {
      "enum": [
        "Q",
        "N"
      ]
    },
    "layout": {
      "enum": [
        "layout0",
        "layout1"
      ]
    },
    "pairing": {
      "type": "integer",
      "enum": [
        0,
        1
      ]
    },
    "q_label": {
      "enum": [
        "A",
        "B"
      ]
    },
    "n_label": {
      "enum": [
        "A",
        "B"
      ]
    },
    "authorized_label": {
      "enum": [
        "A",
        "B"
      ]
    },
    "model_id": {
      "type": "string"
    },
    "provider_route": {
      "type": [
        "string",
        "null"
      ]
    },
    "timestamp_utc": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "request_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "settings_json": {
      "type": [
        "string",
        "null"
      ]
    },
    "attempt_status": {
      "enum": [
        "planned",
        "valid_Q",
        "valid_N",
        "invalid_refusal",
        "invalid_format",
        "uninterpretable",
        "transport_failure",
        "provider_error",
        "not_attempted"
      ]
    },
    "raw_response": {
      "type": [
        "string",
        "null"
      ]
    },
    "input_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "output_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "reasoning_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "billed_cost_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
